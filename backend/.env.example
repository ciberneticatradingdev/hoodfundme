# Robinhood Chain mainnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# HoodFund contract (set after deploy)
FUND_ADDRESS=
# First block to index (the contract's deploy block)
START_BLOCK=
DATABASE_URL=postgres://localhost:5432/hoodfundme
PORT=4100
# Keeper wallet (gas only — never holds donations). Leave empty to disable auto-flush.
KEEPER_PK=
FLUSH_THRESHOLD_ETH=0.005
KEEPER_INTERVAL_MS=60000

# ---- charity launchpad (pons v2 on Robinhood Chain) ----
# PONS_FACTORY / PONS_FEE_ESCROW default to mainnet addresses
# 32-byte hex key (64 chars) — AES-256-GCM for custodial launch wallet secrets
MASTER_KEY=
LAUNCH_GAS_ETH=0.003
GAS_RESERVE_ETH=0.0015
MIN_CLAIM_ETH=0.002
FEE_KEEPER_MS=300000

# ---- cause modes ----
# donate.gg developer API key (merges their live charity list into /api/charities)
DONATE_GG_API_KEY=
# platform giving wallet for orgs whose own address isn't wired (CHARITY_ADDR_<ID>=0x…)
CHARITY_PAYOUT_WALLET=
# per-org direct addresses, e.g. CHARITY_ADDR_ST_JUDE=0x…
# GoFundMe mode payout wallet — grokbot runs the GoFundMe deposits every 6h from here
GOFUNDME_PAYOUT_WALLET=
